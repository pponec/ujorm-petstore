<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.ujorm.petstore</groupId>
    <artifactId>ujorm-petstore</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>UjormPetstore</name>
    <description>Ujorm3 PetStore Demonstration on Avaje</description>

    <properties>
        <java.version>25</java.version>
        <ujorm.version>3.0.6-SNAPSHOT</ujorm.version>
        <avaje.inject.version>10.4</avaje.inject.version>
        <jetty.version>12.1.8</jetty.version>
        <junit.version>5.12.2</junit.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Avaje Inject -->
        <dependency>
            <groupId>io.avaje</groupId>
            <artifactId>avaje-inject</artifactId>
            <version>${avaje.inject.version}</version>
        </dependency>

        <!-- Database -->
        <!-- The compile scope is needed by JdbcProvider, which wires the H2 DataSource
             statically so that no driver lookup happens at runtime. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>6.2.1</version>
        </dependency>

        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.1.0</version>
        </dependency>
        <!--
            Embedded servlet container of the native binary built by GraalVM (see Main.java).
            It shares the version property with the Jetty plugin below, so the development
            container and the embedded one can never drift apart. It also brings the
            jakarta.servlet-api, which used to be declared here on its own.

            The provided scope is the accurate one: a servlet container is supplied by the
            deployment target, and it keeps the WAR free of a second copy of Jetty. The whole
            tree stays on the compile class path, hence the native build sees it as well.
        -->
        <dependency>
            <groupId>org.eclipse.jetty.ee10</groupId>
            <artifactId>jetty-ee10-servlet</artifactId>
            <version>${jetty.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Ujorm -->
        <dependency>
            <groupId>org.ujorm</groupId>
            <artifactId>ujo-core</artifactId>
            <version>${ujorm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ujorm</groupId>
            <artifactId>ujo-orm</artifactId>
            <version>${ujorm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ujorm</groupId>
            <artifactId>ujo-web</artifactId>
            <version>${ujorm.version}</version>
        </dependency>

        <!--
            Annotations of the GraalVM substitution in the nativeimage package. The version
            matches the GraalVM of the Docker image in run-ujorm-petstore-native.sh. It is a
            build-time only artifact: provided scope keeps it out of the WAR, and nothing loads
            the substitution class on a JVM.
        -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>25.0.2</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.12</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.12</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.avaje</groupId>
                            <artifactId>avaje-inject-generator</artifactId>
                            <version>${avaje.inject.version}</version>
                        </path>
                        <path>
                            <groupId>org.ujorm</groupId>
                            <artifactId>ujorm-meta-processor</artifactId>
                            <version>${ujorm.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aujorm.prefix=Q</arg>
                        <arg>-Aujorm.suffix=</arg>
                        <arg>-Aujorm.metaPackage=meta</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!--
            Ujorm Handler Pre-compiler: builds the DomainHandler classes at build time,
            so no Java compiler is needed at runtime (GraalVM native image, plain JRE,
            or an isolated servlet class loader). The entity list comes from the
            META-INF/ujorm/entities.lst index written by the Ujorm annotation processor.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>ujorm-precompile-handlers</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>org.ujorm.core.generator.HandlerPrecompiler</argument>
                                <argument>${project.build.outputDirectory}</argument>
                                <argument>${project.build.directory}/generated-sources/ujorm-handlers</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
            Collects the dependencies into target/deps, so the native-image build
            can pass a plain class path. See run-ujorm-petstore-native.sh
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>ujorm-native-classpath</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/deps</outputDirectory>
                            <!-- "compile" means compile + provided + system in this plugin,
                                 so the embedded Jetty ends up on the native class path too. -->
                            <includeScope>compile</includeScope>
                            <!-- The GraalVM artifacts are the image builder; native-image
                                 rejects them on the class path of the image it builds. -->
                            <excludeGroupIds>org.graalvm.nativeimage,org.graalvm.sdk,org.graalvm.compiler,org.graalvm.truffle,org.graalvm.polyglot</excludeGroupIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- WAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- Jetty Plugin -->
            <plugin>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-maven-plugin</artifactId>
                <version>${jetty.version}</version>
                <configuration>
                    <scan>1</scan>
                    <httpConnector>
                        <port>8080</port>
                    </httpConnector>
                    <webApp>
                        <contextPath>/</contextPath>
                        <resourceBases>
                            <resourceBase>${project.basedir}/src/main/resources/META-INF/resources</resourceBase>
                        </resourceBases>
                    </webApp>
                    <systemProperties>
                        <systemProperty>
                            <name>java.util.logging.config.file</name>
                            <value>${project.basedir}/src/main/resources/logging.properties</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
                <!--
                The Ujorm libraries are no longer needed on the plugin class path: the domain
                handlers are pre-compiled by the exec-maven-plugin above, so Jetty's isolated
                webapp class loader has nothing left to compile at runtime.
                -->
                <dependencies>
                    <dependency>
                        <groupId>org.slf4j</groupId>
                        <artifactId>slf4j-jdk-platform-logging</artifactId>
                        <version>2.0.12</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>